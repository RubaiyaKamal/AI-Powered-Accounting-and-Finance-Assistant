          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e6a" value="5. Read-only query (context for suggestion / report)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#1C1C1E;dashed=1;" edge="1" parent="1" source="tools_core" target="db">
          <mxGeometry relative="1" as="geometry" />
