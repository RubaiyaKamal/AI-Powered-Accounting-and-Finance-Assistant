              <mxPoint x="330" y="60" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e10" value="9. Confirm → normal POST/PATCH (same endpoint as manual entry)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontColor=#C9A227;strokeColor=#C9A227;dashed=1;" edge="1" parent="1" source="frontend" target="backend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edges: agent invokes each themed tool box, tools read db, tools respond to backend -->
        <mxCell id="e5a" value="4a. Agent invokes an entry/report tool" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#1C1C1E;" edge="1" parent="1" source="agent" target="tools_core">
          <mxGeometry relative="1" as="geometry" />
