        <mxCell id="e5c" value="4c. Agent invokes an audit tool" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#1C1C1E;" edge="1" parent="1" source="agent" target="tools_audit">
